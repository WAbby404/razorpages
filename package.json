{
  "name": "razorpages-client",
  "version": "1.0.0",
  "description": "TypeScript client-side code for Razor Pages app",
  "scripts": {
    "build": "tsc",
    "build:bundle": "tsc --noEmit && esbuild wwwroot/js/main.ts --bundle --outfile=wwwroot/js/bundle.js --target=es2022 --format=iife",
    "build:prod": "tsc --noEmit && esbuild wwwroot/js/main.ts --bundle --outfile=wwwroot/js/bundle.js --target=es2022 --format=iife --minify --sourcemap",
    "check": "tsc --noEmit",
    "watch": "tsc --watch",
    "watch:bundle": "esbuild wwwroot/js/main.ts --bundle --outfile=wwwroot/js/bundle.js --target=es2022 --format=iife --watch",
    "dotnet": "dotnet run",
    "dev": "npm-run-all --parallel watch:bundle dotnet",
    "start": "npm run dev"
  },
  "devDependencies": {
    "esbuild": "^0.27.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.3.0"
  }
}
