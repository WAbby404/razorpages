{
  "compilerOptions": {
    "target": "ES2022",              // Output compatible with ES2022 browsers
    "module": "ES2022",
    "lib": ["ES2024", "DOM"],        // Write code using ES2024 features
    "outDir": ".",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "node",
    "allowSyntheticDefaultImports": true
  },
  "include": ["*.ts"],
  "exclude": ["*.js", "node_modules"]
}
