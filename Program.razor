                "Product 1",
                "Product 2",
                "Product 3",
                "Product 4",
                "Product 5",
                "Product 6",
                "Product 7",
                "Product 8"
            };
            
            RenderFragment content = @<div>
                <h1 class="text-3xl font-bold text-gray-800 mb-6">Grid Demo</h1>
                @Grid(items)
            </div>;
            
            return Results.Razor(TailwindLayout("Grid Demo", content, context: context));
        });

        app.MapGet("/composite", (HttpContext context) =>
        {
            var model = new HomeModel
            {
                Title = "Composite Page",
                Message = "This page embeds other RenderFragments!",
                CurrentTime = DateTime.Now,
                VisitorCount = 123
            };
            var items = new List<string> { "Item A", "Item B", "Item C", "Item D" };
            return Results.Razor(Layout(Home(model), Grid(items)));
        });

        app.MapGet("/cards", (HttpContext context) =>
        {
            var model = new HomeModel { Title = "Welcome", Message = "Hello from a card!" };
            var items = new List<string> { "Feature 1", "Feature 2", "Feature 3" };
            
            // Card embedding Home fragment
            var card1 = Card("Home Info", Home(model));
            
            // Card embedding Grid fragment
            var card2 = Card("Features Grid", Grid(items));
            
            // Create a container that has both cards
            RenderFragment content = @<div>
                <h1 class="text-3xl font-bold text-gray-800 mb-6">Cards Demo</h1>
                @card1
                @card2
            </div>;
            
            return Results.Razor(TailwindLayout("Cards Demo", content, context: context));
        });

        app.MapGet("/events", (HttpContext context) =>
        {
            RenderFragment page = @<html lang="en">
                <head>
                    <meta charset="UTF-8" />
                    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
                    <title>Event Cards</title>
                    <script src="https://cdn.tailwindcss.com"></script>
                </head>
                <body class="bg-gray-50 min-h-screen p-8">
                    <div class="container mx-auto max-w-4xl">
                        <h1 class="text-4xl font-bold text-gray-800 mb-8">Cards with Events</h1>
                        
                        @ClickableCard("Alert Card", "Click this card to see an alert!", "alert('You clicked the card!')")
                        
                        @ClickableCard("Console Log", "This card logs to the console", "console.log('Card clicked at: ' + new Date())")
                        
                        @LinkCard("Navigation Card", "Click the link to go to the grid page", "/grid")
                        
                        @LinkCard("External Link", "Visit Google", "https://google.com")
                        
                        @FormCard("Search Card", "/search")
