            RenderFragment content = @<div>
                <a href="/products" class="inline-flex items-center text-blue-600 hover:text-blue-800 mb-6 transition-colors">
                    ← Back to Products
                </a>
                <div class="bg-white rounded-lg shadow-lg p-8 max-w-2xl">
