            if (!context.User.Identity?.IsAuthenticated ?? true)
            {
                return Results.Redirect("/login?returnUrl=/subscribe");
            }

            var publishableKey = builder.Configuration["Stripe:PublishableKey"] ?? "pk_test_YOUR_PUBLISHABLE_KEY_HERE";

            RenderFragment content = @<div>
                <div class="max-w-6xl mx-auto">
                    <div class="text-center mb-12">
