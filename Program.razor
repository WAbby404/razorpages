                                            <p class="text-gray-600">@subscription.StripePriceId</p>
                                        </div>
                                        <span class="px-4 py-2 rounded-full text-sm font-semibold @(subscription.Status == "active" ? "bg-green-100 text-green-800" : "bg-gray-100 text-gray-800")">
                                            @subscription.Status.ToUpper()
                                        </span>
                                    </div>

                                    @if (subscription.CurrentPeriodStart.HasValue && subscription.CurrentPeriodEnd.HasValue)
                                    {
                                        <div class="grid grid-cols-2 gap-4 text-sm text-gray-600 mb-4">
                                            <div>
                                                <span class="font-semibold">Period Start:</span> @subscription.CurrentPeriodStart.Value.ToString("MMM dd, yyyy")
                                            </div>
                                            <div>
                                                <span class="font-semibold">Period End:</span> @subscription.CurrentPeriodEnd.Value.ToString("MMM dd, yyyy")
                                            </div>
