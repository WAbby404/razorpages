@using Microsoft.AspNetCore.Components;
@using Microsoft.EntityFrameworkCore;

@code {
    public class Product
{
    public int Id { get; set; }
    public string Name { get; set; } = string.Empty;
    public string Description { get; set; } = string.Empty;
    public decimal Price { get; set; }
    public DateTime CreatedAt { get; set; } = DateTime.Now;
}

public class Category
{
    public int Id { get; set; }
    public string Name { get; set; } = string.Empty;
    public string Description { get; set; } = string.Empty;
}

// Database Context
public class AppDbContext : DbContext
{
    public AppDbContext(DbContextOptions<AppDbContext> options) : base(options)
    {
    }

    public DbSet<Product> Products { get; set; }
    public DbSet<Category> Categories { get; set; }

    protected override void OnModelCreating(ModelBuilder modelBuilder)
    {
        base.OnModelCreating(modelBuilder);

        // Seed some initial data
        modelBuilder.Entity<Category>().HasData(
            new Category { Id = 1, Name = "Electronics", Description = "Electronic devices and gadgets" },
            new Category { Id = 2, Name = "Books", Description = "Physical and digital books" },
            new Category { Id = 3, Name = "Clothing", Description = "Apparel and accessories" }
        );

        modelBuilder.Entity<Product>().HasData(
            new Product { Id = 1, Name = "Laptop", Description = "High-performance laptop", Price = 999.99m, CreatedAt = DateTime.Now },
            new Product { Id = 2, Name = "Mouse", Description = "Wireless mouse", Price = 29.99m, CreatedAt = DateTime.Now },
            new Product { Id = 3, Name = "Keyboard", Description = "Mechanical keyboard", Price = 79.99m, CreatedAt = DateTime.Now },
            new Product { Id = 4, Name = "C# Programming", Description = "Learn C# fundamentals", Price = 39.99m, CreatedAt = DateTime.Now },
            new Product { Id = 5, Name = "T-Shirt", Description = "Cotton t-shirt", Price = 19.99m, CreatedAt = DateTime.Now }
        );
    }
}

    public class HomeModel
    {
        public string Title { get; set; } = "Welcome to My App";
        public string Message { get; set; } = "Hello, World!";
        public DateTime CurrentTime { get; set; } = DateTime.Now;
        public int VisitorCount { get; set; } = 42;
    }

    public static void Main(string[] args)
    {
        var builder = WebApplication.CreateBuilder(args);

        builder.Services.AddRazorComponents();

        // Add Entity Framework Core with SQLite
        builder.Services.AddDbContext<AppDbContext>(options =>
            options.UseSqlite("Data Source=app.db"));

        var app = builder.Build();

        // Create database and apply migrations on startup
        using (var scope = app.Services.CreateScope())
        {
            var db = scope.ServiceProvider.GetRequiredService<AppDbContext>();
            db.Database.EnsureCreated();
        }

        // Enable static files from wwwroot
        app.UseStaticFiles();

        app.MapGet("/", () =>
        {
            var model = new HomeModel
            {
                Title = "Dynamic Home Page",
                Message = "This is dynamic content from the model!",
                CurrentTime = DateTime.Now,
                VisitorCount = new Random().Next(1, 1000)
            };
            return Results.Razor(TailwindLayout("Home", Home(model)));
        });

        app.MapGet("/grid", () =>
        {
            var items = new List<string>
            {
                "Product 1",
                "Product 2",
                "Product 3",
                "Product 4",
                "Product 5",
                "Product 6",
                "Product 7",
                "Product 8"
            };
            
            RenderFragment content = @<div>
                <h1 class="text-3xl font-bold text-gray-800 mb-6">Grid Demo</h1>
                @Grid(items)
            </div>;
            
            return Results.Razor(TailwindLayout("Grid Demo", content));
        });

        app.MapGet("/composite", () =>
        {
            var model = new HomeModel
            {
                Title = "Composite Page",
                Message = "This page embeds other RenderFragments!",
                CurrentTime = DateTime.Now,
                VisitorCount = 123
            };
            var items = new List<string> { "Item A", "Item B", "Item C", "Item D" };
            return Results.Razor(Layout(Home(model), Grid(items)));
        });

        app.MapGet("/cards", () =>
        {
            var model = new HomeModel { Title = "Welcome", Message = "Hello from a card!" };
            var items = new List<string> { "Feature 1", "Feature 2", "Feature 3" };
            
            // Card embedding Home fragment
            var card1 = Card("Home Info", Home(model));
            
            // Card embedding Grid fragment
            var card2 = Card("Features Grid", Grid(items));
            
            // Create a container that has both cards
            RenderFragment content = @<div>
                <h1 class="text-3xl font-bold text-gray-800 mb-6">Cards Demo</h1>
                @card1
                @card2
            </div>;
            
            return Results.Razor(TailwindLayout("Cards Demo", content));
        });

        app.MapGet("/events", () =>
        {
            RenderFragment page = @<html lang="en">
                <head>
                    <meta charset="UTF-8" />
                    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
                    <title>Event Cards</title>
                    <script src="https://cdn.tailwindcss.com"></script>
                </head>
                <body class="bg-gray-50 min-h-screen p-8">
                    <div class="container mx-auto max-w-4xl">
                        <h1 class="text-4xl font-bold text-gray-800 mb-8">Cards with Events</h1>
                        
                        @ClickableCard("Alert Card", "Click this card to see an alert!", "alert('You clicked the card!')")
                        
                        @ClickableCard("Console Log", "This card logs to the console", "console.log('Card clicked at: ' + new Date())")
                        
                        @LinkCard("Navigation Card", "Click the link to go to the grid page", "/grid")
                        
                        @LinkCard("External Link", "Visit Google", "https://google.com")
                        
                        @FormCard("Search Card", "/search")
                    </div>
                </body>
            </html>;
            
            return Results.Razor(page);
        });

        app.MapGet("/search", (string? query) =>
        {
            var result = string.IsNullOrEmpty(query) 
                ? "No search query provided" 
                : $"You searched for: {query}";
            
            RenderFragment content = @<div>
                <div class="bg-white rounded-lg shadow-md p-8 max-w-2xl">
                    <h1 class="text-3xl font-bold text-gray-800 mb-4">Search Results</h1>
                    <p class="text-lg text-gray-700 mb-6">@result</p>
                    <a href="/events" class="inline-flex items-center text-blue-600 hover:text-blue-800 transition-colors">
                        ← Back to Events
                    </a>
                </div>
            </div>;
            
            return Results.Razor(TailwindLayout("Search Results", content));
        });

        app.MapGet("/external-js", () =>
        {
            RenderFragment pageContent = @<div>
                <h1 class="text-4xl font-bold text-gray-800 mb-4">Cards with External JavaScript</h1>
                <p class="text-gray-600 mb-8">These cards use JavaScript functions defined in external .js files!</p>
                
                @ExternalJSCard("card1", "Interactive Card 1", "This card uses external JavaScript for all interactions. Try clicking it or the buttons!")
                
                @ExternalJSCard("card2", "Interactive Card 2", "Hover over this card to see the highlight effect from cards.js")
                
                @ExpandableCard("card3", "Expandable Card", "This is a preview. Click to see more...", "Here is the full content that was hidden! This uses the toggleCardExpand() function from the external cards.js file.")
                
                @ExpandableCard("card4", "Another Expandable", "Click the toggle button...", "More detailed information can go here. You can put any content in the expandable section!")
                
                <div class="mt-8 p-6 bg-white rounded-lg shadow-md">
                    <h3 class="text-xl font-bold text-gray-800 mb-4">About External JavaScript</h3>
                    <p class="text-gray-700 mb-3">The JavaScript functions are loaded from:</p>
                    <ul class="list-disc list-inside space-y-2 text-gray-600 mb-4">
                        <li><code class="bg-gray-100 px-2 py-1 rounded text-sm">/js/cards.js</code> - Card-specific functions (handleCardClick, toggleCardExpand, etc.)</li>
                        <li><code class="bg-gray-100 px-2 py-1 rounded text-sm">/js/utils.js</code> - Utility functions (UIHelpers.showNotification, etc.)</li>
                    </ul>
                    <p class="text-gray-700">The CSS is loaded from <code class="bg-gray-100 px-2 py-1 rounded text-sm">/css/styles.css</code></p>
                </div>
            </div>;
            
            return Results.Razor(PageWithExternalAssets("External JS Demo", pageContent));
        });

        // Database routes
        app.MapGet("/products", async (AppDbContext db) =>
        {
            var products = await db.Products.ToListAsync();
            
            RenderFragment content = @<div>
                <div class="flex justify-between items-center mb-6">
                    <div>
                        <h1 class="text-3xl font-bold text-gray-800 mb-2">Products</h1>
                        <p class="text-gray-600">Total products: <span class="font-semibold">@products.Count</span></p>
                    </div>
                    <a href="/add-product" class="bg-blue-600 text-white px-6 py-3 rounded-lg hover:bg-blue-700 transition-colors shadow-md">
                        + Add Product
                    </a>
                </div>
                @Grid(products)
            </div>;
            
            return Results.Razor(TailwindLayout("Products", content));
        });

        app.MapGet("/categories", async (AppDbContext db) =>
        {
            var categories = await db.Categories.ToListAsync();
            
            RenderFragment content = @<div>
                <h1 class="text-3xl font-bold text-gray-800 mb-2">Categories</h1>
                <p class="text-gray-600 mb-6">Total categories: <span class="font-semibold">@categories.Count</span></p>
                @Grid(categories)
            </div>;
            
            return Results.Razor(TailwindLayout("Categories", content));
        });

        app.MapGet("/product/{id}", async (int id, AppDbContext db) =>
        {
            var product = await db.Products.FindAsync(id);
            
            if (product == null)
            {
                return Results.NotFound($"Product with ID {id} not found");
            }
            
            RenderFragment content = @<div>
                <a href="/products" class="inline-flex items-center text-blue-600 hover:text-blue-800 mb-6 transition-colors">
                    ← Back to Products
                </a>
                <div class="bg-white rounded-lg shadow-lg p-8 max-w-2xl">
                    <h1 class="text-4xl font-bold text-gray-800 mb-6">@product.Name</h1>
                    <div class="space-y-4">
                        <div>
                            <span class="text-sm font-semibold text-gray-500 uppercase">Description</span>
                            <p class="text-lg text-gray-700 mt-1">@product.Description</p>
                        </div>
                        <div>
                            <span class="text-sm font-semibold text-gray-500 uppercase">Price</span>
                            <p class="text-3xl font-bold text-green-600 mt-1">$@product.Price.ToString("F2")</p>
                        </div>
                        <div>
                            <span class="text-sm font-semibold text-gray-500 uppercase">Created</span>
                            <p class="text-gray-700 mt-1">@product.CreatedAt.ToString("F")</p>
                        </div>
                    </div>
                </div>
            </div>;
            
            return Results.Razor(TailwindLayout($"Product: {product.Name}", content));
        });

        app.MapGet("/add-product", () =>
        {
            RenderFragment content = @<div>
                <a href="/products" class="inline-flex items-center text-blue-600 hover:text-blue-800 mb-6 transition-colors">
                    ← Back to Products
                </a>
                <div class="bg-white rounded-lg shadow-lg p-8 max-w-2xl">
                    <h1 class="text-3xl font-bold text-gray-800 mb-6">Add New Product</h1>
                    <form method="post" action="/products" class="space-y-6">
                        <div>
                            <label class="block text-sm font-semibold text-gray-700 mb-2">Name</label>
                            <input type="text" 
                                   name="name" 
                                   required 
                                   class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent" 
                                   placeholder="Enter product name" />
                        </div>
                        <div>
                            <label class="block text-sm font-semibold text-gray-700 mb-2">Description</label>
                            <textarea name="description" 
                                      required 
                                      rows="4"
                                      class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent" 
                                      placeholder="Enter product description"></textarea>
                        </div>
                        <div>
                            <label class="block text-sm font-semibold text-gray-700 mb-2">Price</label>
                            <div class="relative">
                                <span class="absolute left-3 top-2 text-gray-500">$</span>
                                <input type="number" 
                                       name="price" 
                                       step="0.01" 
                                       required 
                                       class="w-full pl-8 pr-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent" 
                                       placeholder="0.00" />
                            </div>
                        </div>
                        <div class="flex gap-4">
                            <button type="submit" 
                                    class="flex-1 bg-green-600 text-white px-6 py-3 rounded-lg hover:bg-green-700 transition-colors font-semibold shadow-md">
                                Add Product
                            </button>
                            <a href="/products" 
                               class="flex-1 bg-gray-200 text-gray-700 px-6 py-3 rounded-lg hover:bg-gray-300 transition-colors font-semibold text-center">
                                Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>;
            
            return Results.Razor(TailwindLayout("Add Product", content));
        });

        app.MapPost("/products", async (HttpRequest request, AppDbContext db) =>
        {
            var form = await request.ReadFormAsync();
            
            var product = new Product
            {
                Name = form["name"].ToString(),
                Description = form["description"].ToString(),
                Price = decimal.Parse(form["price"].ToString()),
                CreatedAt = DateTime.Now
            };
            
            db.Products.Add(product);
            await db.SaveChangesAsync();
            
            return Results.Redirect("/products");
        });

        app.Run();
    }

    private static RenderFragment Home(HomeModel model)
    {
        return @<div class="bg-white rounded-lg shadow-md p-6">
            <h1 class="text-3xl font-bold text-gray-800 mb-4">@model.Title</h1>
            <p class="text-lg text-gray-600 mb-3">@model.Message</p>
            <p class="text-sm text-gray-500 mb-2">
                <span class="font-semibold">Current Time:</span> @model.CurrentTime.ToString("F")
            </p>
            <p class="text-sm text-gray-500">
                <span class="font-semibold">Visitor Count:</span> 
                <span class="inline-block bg-blue-100 text-blue-800 px-3 py-1 rounded-full">@model.VisitorCount</span>
            </p>
        </div>;
    }

    private static RenderFragment Grid<T>(List<T> items)
    {
        return @<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
            @foreach (var item in items)
            {
                <div class="bg-white rounded-lg shadow-md hover:shadow-xl transition-shadow duration-300 overflow-hidden">
                    @if (item is Product product)
                    {
                        <div class="p-6">
                            <h3 class="text-xl font-bold text-blue-600 mb-2">@product.Name</h3>
                            <p class="text-gray-600 text-sm mb-4 line-clamp-2">@product.Description</p>
                            <div class="flex justify-between items-center">
                                <p class="text-2xl font-bold text-green-600">$@product.Price.ToString("F2")</p>
                                <a href="/product/@product.Id" 
                                   class="text-blue-600 hover:text-blue-800 font-medium text-sm transition-colors">
                                    View Details →
                                </a>
                            </div>
                        </div>
                    }
                    else if (item is Category category)
                    {
                        <div class="p-6">
                            <h3 class="text-xl font-bold text-yellow-600 mb-2">@category.Name</h3>
                            <p class="text-gray-600 text-sm">@category.Description</p>
                        </div>
                    }
                    else
                    {
                        <div class="p-6">
                            <p class="text-gray-700">@item?.ToString()</p>
                        </div>
                    }
                </div>
            }
        </div>;
    }

    // Layout that embeds multiple RenderFragments
    private static RenderFragment Layout(RenderFragment header, RenderFragment content)
    {
        return @<html>
            <head>
                <title>My App</title>
                <script src="https://cdn.tailwindcss.com"></script>
            </head>
            <body class="bg-gray-50">
                <div class="bg-gray-800 text-white p-4">
                    @header
                </div>
                <div class="p-4">
                    @content
                </div>
            </body>
        </html>;
    }

    // Example: RenderFragment that accepts another RenderFragment as parameter
    private static RenderFragment Card(string title, RenderFragment body)
    {
        return @<div class="border-2 border-blue-500 rounded-lg p-6 my-4 shadow-md bg-white">
            <h2 class="text-blue-600 text-2xl font-bold mb-4">@title</h2>
            <div>
                @body
            </div>
        </div>;
    }

    // Card with JavaScript click event
    private static RenderFragment ClickableCard(string title, string message, string jsAction)
    {
        return @<div 
            class="border-2 border-green-500 rounded-lg p-6 my-4 shadow-md bg-white cursor-pointer transform transition-transform hover:scale-105"
            onclick="@jsAction">
            <h2 class="text-green-600 text-2xl font-bold mb-2">@title</h2>
            <p class="text-gray-700 mb-2">@message</p>
            <small class="text-gray-500">Click me!</small>
        </div>;
    }

    // Card with a link (navigation event)
    private static RenderFragment LinkCard(string title, string description, string url)
    {
        return @<div class="border-2 border-yellow-400 rounded-lg p-6 my-4 shadow-md bg-white hover:shadow-lg transition-shadow">
            <h2 class="text-yellow-600 text-2xl font-bold mb-2">@title</h2>
            <p class="text-gray-700 mb-4">@description</p>
            <a href="@url" class="text-blue-600 hover:text-blue-800 font-bold inline-flex items-center transition-colors">
                Visit →
            </a>
        </div>;
    }

    // Card with a form submission
    private static RenderFragment FormCard(string title, string actionUrl)
    {
        return @<div class="border-2 border-red-500 rounded-lg p-6 my-4 shadow-md bg-white">
            <h2 class="text-red-600 text-2xl font-bold mb-4">@title</h2>
            <form method="get" action="@actionUrl" class="flex gap-2">
                <input type="text" 
                       name="query" 
                       placeholder="Enter something..." 
                       class="flex-1 px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-red-500" />
                <button type="submit" 
                        class="px-6 py-2 bg-red-600 text-white rounded-lg hover:bg-red-700 transition-colors">
                    Submit
                </button>
            </form>
        </div>;
    }

    // Card using external JavaScript functions
    private static RenderFragment ExternalJSCard(string id, string title, string content)
    {
        return @<div id="@id" 
            class="border-2 border-purple-500 rounded-lg p-6 my-4 shadow-md bg-white cursor-pointer transition-all hover:shadow-xl"
            onclick="handleCardClick('@id', 'Card clicked!')"
            onmouseenter="highlightCard(this)"
            onmouseleave="unhighlightCard(this)">
            <h2 class="text-purple-600 text-2xl font-bold mb-3">@title</h2>
            <div>
                <p class="text-gray-700 mb-4">@content</p>
                <div class="flex gap-2">
                    <button class="px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors" 
                            onclick="event.stopPropagation(); logCardClick('@id')">
                        Log Click
                    </button>
                    <button class="px-4 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700 transition-colors" 
                            onclick="event.stopPropagation(); UIHelpers.showNotification('Hello from @title!', 'success')">
                        Show Notification
                    </button>
                </div>
            </div>
        </div>;
    }

    // Expandable card using external JavaScript
    private static RenderFragment ExpandableCard(string id, string title, string preview, string fullContent)
    {
        return @<div id="@id" class="border-2 border-indigo-500 rounded-lg p-6 my-4 shadow-md bg-white">
            <h2 class="text-indigo-600 text-2xl font-bold mb-3">@title</h2>
            <p class="text-gray-700 mb-4">@preview</p>
            <button class="px-4 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 transition-colors" 
                    onclick="toggleCardExpand('@id')">
                Toggle Details
            </button>
            <div class="expandable-content hidden mt-4 pt-4 border-t border-gray-200">
                <p class="text-gray-700">@fullContent</p>
            </div>
        </div>;
    }

    // Page layout with external JS/CSS references
    private static RenderFragment PageWithExternalAssets(string title, RenderFragment content)
    {
        return @<html lang="en">
            <head>
                <meta charset="UTF-8" />
                <meta name="viewport" content="width=device-width, initial-scale=1.0" />
                <title>@title</title>
                <script src="https://cdn.tailwindcss.com"></script>
                <link rel="stylesheet" href="/css/styles.css" />
            </head>
            <body class="bg-gray-50 min-h-screen p-8">
                <div class="container mx-auto">
                    @content
                </div>
                
                <!-- Load external JavaScript files -->
                <script src="/js/cards.js"></script>
                <script src="/js/utils.js"></script>
            </body>
        </html>;
    }

    // Tailwind CSS Layout - Base layout with Tailwind from CDN
    private static RenderFragment TailwindLayout(string title, RenderFragment content, bool includeNav = true)
    {
        return @<html lang="en">
            <head>
                <meta charset="UTF-8" />
                <meta name="viewport" content="width=device-width, initial-scale=1.0" />
                <title>@title</title>
                <!-- Tailwind CSS from CDN -->
                <script src="https://cdn.tailwindcss.com"></script>
                <style type="text/tailwindcss">
                    @@layer utilities {
                        .transition-all {
                            transition-property: all;
                            transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
                            transition-duration: 150ms;
                        }
                    }
                </style>
            </head>
            <body class="bg-gray-50 min-h-screen">
                @if (includeNav)
                {
                    @Navigation()
                }
                <main class="container mx-auto px-4 py-8">
                    @content
                </main>
                <footer class="bg-gray-800 text-white py-6 mt-12">
                    <div class="container mx-auto px-4 text-center">
                        <p class="text-sm">&copy; 2025 Razor Pages App. Built with ASP.NET Core & Tailwind CSS.</p>
                    </div>
                </footer>
            </body>
        </html>;
    }

    // Navigation component
    private static RenderFragment Navigation()
    {
        return @<nav class="bg-white shadow-lg">
            <div class="container mx-auto px-4">
                <div class="flex justify-between items-center py-4">
                    <div class="flex items-center space-x-8">
                        <a href="/" class="text-2xl font-bold text-blue-600 hover:text-blue-700">RazorPages</a>
                        <div class="hidden md:flex space-x-6">
                            <a href="/products" class="text-gray-700 hover:text-blue-600 transition-colors">Products</a>
                            <a href="/categories" class="text-gray-700 hover:text-blue-600 transition-colors">Categories</a>
                            <a href="/grid" class="text-gray-700 hover:text-blue-600 transition-colors">Grid Demo</a>
                            <a href="/events" class="text-gray-700 hover:text-blue-600 transition-colors">Events</a>
                        </div>
                    </div>
                    <div>
                        <a href="/add-product" class="bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700 transition-colors">
                            Add Product
                        </a>
                    </div>
                </div>
            </div>
        </nav>;
    }
}
