        {
            // Validate credentials
            var user = await db.Users.FirstOrDefaultAsync(u => u.Username == loginRequest.Username);
            
            if (user == null || !VerifyPassword(loginRequest.Password, user.PasswordHash))
            {
                return Results.Json(new { error = "Invalid credentials" }, statusCode: 401);
            }

            // Generate JWT token
            var token = GenerateJwtToken(user, jwtSecret, jwtIssuer, jwtAudience);
            
            return Results.Json(new
            {
                token = token,
                username = user.Username,
                email = user.Email,
                expiresIn = 3600 // 1 hour in seconds
            });
        });

        // API: Get all products (requires JWT token)
        app.MapGet("/api/products", async (HttpContext context, AppDbContext db) =>
        {
            // Check if authenticated via JWT
