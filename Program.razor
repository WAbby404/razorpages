                <h1 class="text-4xl font-bold text-gray-800 mb-4">Cards with External JavaScript</h1>
                <p class="text-gray-600 mb-8">These cards use JavaScript functions defined in external .js files!</p>
                
                @ExternalJSCard("card1", "Interactive Card 1", "This card uses external JavaScript for all interactions. Try clicking it or the buttons!")
                
                @ExternalJSCard("card2", "Interactive Card 2", "Hover over this card to see the highlight effect from cards.js")
                
                @ExpandableCard("card3", "Expandable Card", "This is a preview. Click to see more...", "Here is the full content that was hidden! This uses the toggleCardExpand() function from the external cards.js file.")
                
                @ExpandableCard("card4", "Another Expandable", "Click the toggle button...", "More detailed information can go here. You can put any content in the expandable section!")
                
