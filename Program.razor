                Name = "Pro",
                Description = "For power users",
                MonthlyPrice = 29.99m,
                YearlyPrice = 299.99m,
                MonthlyPriceId = builder.Configuration["Stripe:PriceIds:MonthlyPro"] ?? "price_YOUR_MONTHLY_PRO_PRICE_ID",
                YearlyPriceId = builder.Configuration["Stripe:PriceIds:YearlyPro"] ?? "price_YOUR_YEARLY_PRO_PRICE_ID",
                Features = new List<string> { "Everything in Basic", "Feature 4", "Feature 5", "Priority Support", "Advanced Analytics" }
